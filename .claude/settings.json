{
  "permissions": {
    "deny": [
      "Edit(/.oxlintrc.json)",
      "Edit(/.oxfmtrc.json)",
      "Edit(/lefthook.yml)",
      "Edit(/tsconfig.json)",
      "Edit(/public/map.js)",
      "Edit(/public/turbo.js)",
      "Edit(/public/output.css)",
      "Edit(/output/licenses.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-no-verify.ts\""
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-protected-edits.ts\""
          }
        ]
      }
    ]
  }
}
